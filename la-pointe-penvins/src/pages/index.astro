---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Hours from '../components/Hours.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../data/site';
import { url } from '../data/url';

import hero from '../assets/photos/pointe-penvins-vue-aerienne.jpg';
import panorama from '../assets/photos/terrasse-panorama.jpg';
import enseigne from '../assets/photos/enseigne.jpg';
import routard from '../assets/photos/guide-routard.jpg';
import huitres from '../assets/photos/huitres.jpg';
import cocktail from '../assets/photos/terrasse-guirlandes.jpg';
import soiree from '../assets/photos/soiree-dj.jpg';
import sunset from '../assets/photos/coucher-soleil-dunes.jpg';
import g1 from '../assets/photos/terrasse-vue-drone.jpg';
import g2 from '../assets/photos/cocktail-passion.jpg';
import g3 from '../assets/photos/salon-terrasse.jpg';
import g4 from '../assets/photos/assiette-poisson.jpg';
import g5 from '../assets/photos/kitesurf.jpg';
import g6 from '../assets/photos/terrasse-rose.jpg';
import g7 from '../assets/photos/voie-lactee.jpg';
import chapelle from '../assets/photos/chapelle-plage.jpg';
import plage from '../assets/photos/plage-penvins.jpg';
import glisse from '../assets/photos/wing-foil.jpg';
import golfe from '../assets/photos/baie-voiliers.jpg';
import crepuscule from '../assets/photos/restaurant-crepuscule.jpg';

const experiences = [
  {
    title: 'Le restaurant',
    text: "Huîtres du Morbihan, poisson du moment, planches à partager et burgers maison : une cuisine de produits frais, locaux et bio, servie face à la mer.",
    href: 'restaurant-sur-la-plage/',
    cta: 'Voir le restaurant',
    image: huitres,
    alt: "Plateau d'huîtres du Morbihan servi sur la terrasse, la mer en arrière-plan",
  },
  {
    title: 'Le bar & la terrasse',
    text: "Cocktails maison, verres de vin et huîtres à partager, en continu dès 11h. Une terrasse en bois ouverte sur 270° d'horizon pour ralentir, enfin.",
    href: 'bar-de-plage/',
    cta: 'Voir le bar',
    image: cocktail,
    alt: 'Terrasse de La Pointe à la tombée du jour sous les guirlandes lumineuses, face à la mer',
  },
  {
    title: 'Évènements & groupes',
    text: "Soirées, concerts, anniversaires, EVJF, EVG ou repas d'entreprise : formules sur-mesure dès 15 personnes, avec l'océan pour décor.",
    href: 'nos-actualites/',
    cta: 'Organiser un évènement',
    image: soiree,
    alt: 'Soirée DJ au coucher du soleil sur la plage de Penvins devant un van vintage',
  },
];

const gallery = [
  { src: g1, alt: 'Vue aérienne de la terrasse de La Pointe et de ses parasols blancs', cls: 'g--tall' },
  { src: g2, alt: 'Cocktail à la passion décoré d’un physalis', cls: '' },
  { src: g3, alt: 'Salon extérieur de la terrasse avec coussins bleus au crépuscule', cls: '' },
  { src: g4, alt: 'Assiette de poisson sur crème de betterave et jeunes pousses', cls: 'g--wide' },
  { src: g5, alt: 'Kitesurfeur en plein saut devant la pointe de Penvins', cls: 'g--tall' },
  { src: g6, alt: 'Terrasse en bois sous un ciel rose au coucher du soleil', cls: '' },
  { src: g7, alt: 'Voie lactée au-dessus de la mer, plancton bioluminescent sur le rivage', cls: '' },
];

type Place = { title: string; text: string; image: ImageMetadata; alt: string; position?: string };
const around: Place[] = [
  {
    title: 'La chapelle de Penvins',
    text: 'Silhouette emblématique de la pointe, la chapelle Notre-Dame-de-la-Côte veille sur la plage, à quelques pas de notre terrasse.',
    image: chapelle,
    alt: 'La chapelle de Penvins au bord de la plage, un catamaran échoué sur le sable',
    position: '12% 50%',
  },
  {
    title: 'Les plages & le sentier côtier',
    text: "Sable fin, rochers et sentier côtier : de part et d'autre de la pointe, la côte se découvre à pied ou à vélo.",
    image: plage,
    alt: 'Plage de sable de Penvins à marée basse sous un ciel bleu',
  },
  {
    title: 'Voile, kite & wing foil',
    text: "La Pointe est le club-house du Centre Nautique de Sarzeau : un spot réputé pour la voile et toutes les glisses.",
    image: glisse,
    alt: 'Pratiquants de wing foil dans les vagues au large de Penvins',
  },
  {
    title: 'Le Golfe du Morbihan',
    text: "Entre océan et petite mer, la Presqu'île de Rhuys ouvre sur le Golfe, ses îles, Vannes et la côte sauvage.",
    image: golfe,
    alt: "Vue aérienne de la baie et de voiliers au large de la Presqu'île de Rhuys",
  },
];
---
<BaseLayout
  title="La Pointe — Bar restaurant vue mer à Penvins, Sarzeau · Presqu'île de Rhuys"
  description="La Pointe, bar et restaurant face à l'océan à Penvins (Sarzeau). Vue mer à 270°, cuisine de produits frais, locaux et bio, cocktails et couchers de soleil sur la Presqu'île de Rhuys. Réservez votre table."
>
  <!-- ============ HERO ============ -->
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="hero__media media">
      <Photo
        src={hero}
        alt="Vue aérienne de la Pointe de Penvins, entre plage, rochers et eaux turquoise"
        priority
        position="50% 60%"
      />
    </div>
    <div class="hero__content container">
      <p class="eyebrow hero__in" style="--d:0.1s">Bar · Restaurant · Terrasse — Penvins, Sarzeau</p>
      <h1 id="hero-title" class="hero__title">
        L'océan à 270°, <em>au bout de la pointe.</em>
      </h1>
      <p class="hero__lead">
        Bar, restaurant et terrasse posés sur la Pointe de Penvins. Une cuisine de produits frais, locaux et bio, des
        cocktails, et les plus beaux couchers de soleil de la Presqu'île de Rhuys.
      </p>
      <div class="hero__actions hero__in" style="--d:0.3s">
        <a class="btn btn--light" href={business.links.booking} target="_blank" rel="noopener">
          Réserver une table <Icon name="arrow" />
        </a>
        <a class="btn btn--ghost-light" href={url('restaurant-sur-la-plage/')}>Découvrir la carte</a>
      </div>
    </div>
    <div class="hero__bar container hero__in" style="--d:0.5s">
      <ul role="list">
        <li><Icon name="clock" size={18} /> Ouvert 7j/7 en saison · dès 11h</li>
        <li><Icon name="pin" size={18} /> {business.address.street}, {business.address.city}</li>
        <li class="hero__coords">{business.coordinatesLabel}</li>
      </ul>
      <a class="hero__scroll" href="#le-lieu">
        <span>Découvrir</span>
        <Icon name="arrow-down" size={18} />
      </a>
    </div>
  </section>

  <!-- ============ LE LIEU ============ -->
  <section class="section intro" id="le-lieu" aria-labelledby="lieu-titre">
    <div class="container intro__grid">
      <div class="intro__text">
        <p class="eyebrow" data-reveal>Le lieu</p>
        <h2 id="lieu-titre" class="intro__statement" data-reveal>
          Un club-house les pieds dans le sable, entre <em>la chapelle, les dunes</em> et le grand large.
        </h2>
        <div class="intro__body" data-reveal>
          <p>
            Depuis 2015, La Pointe est le club-house du Centre Nautique de Sarzeau. Alban, moniteur de voile pendant dix
            saisons et amoureux du site depuis l'enfance, y prolonge une histoire de famille commencée sur ce littoral
            dans les années 70.
          </p>
          <p>
            On y vient pour déjeuner après une session de voile, partager une planche au soleil ou trinquer face au
            couchant, avec une équipe aux petits soins.
          </p>
          <a class="link-arrow" href={url('a-propos/')}>Notre histoire <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="intro__visual" data-reveal="fade">
        <div class="intro__main media">
          <Photo
            src={panorama}
            alt="La terrasse de La Pointe et ses parasols face à la mer, au soleil couchant"
            sizes="(min-width: 64em) 45vw, 100vw"
          />
        </div>
        <div class="intro__inset media">
          <Photo
            src={enseigne}
            alt="Enseigne ronde La Pointe — restaurant, bar, terrasse — sur la façade en bois"
            sizes="(min-width: 64em) 18vw, 40vw"
          />
        </div>
      </div>
    </div>

    <div class="container">
      <dl class="figures">
        <div data-reveal style="--reveal-delay:0s">
          <dt>Vue mer panoramique</dt>
          <dd>270°</dd>
        </div>
        <div data-reveal style="--reveal-delay:0.1s">
          <dt>Club-house du CNS depuis</dt>
          <dd>2015</dd>
        </div>
        <div data-reveal style="--reveal-delay:0.2s">
          <dt>Producteurs locaux partenaires</dt>
          <dd>15</dd>
        </div>
        <div data-reveal style="--reveal-delay:0.3s">
          <dt>Ouvert en saison</dt>
          <dd>7j/7</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ EXPÉRIENCES ============ -->
  <section class="section section--sand experiences" aria-labelledby="exp-titre">
    <div class="container">
      <SectionTitle id="exp-titre" eyebrow="Expériences" title="Trois façons de vivre <em>la Pointe</em>">
        <p>Du premier café au dernier cocktail, la terrasse change de lumière toutes les heures. Choisissez la vôtre.</p>
      </SectionTitle>
    </div>
    <ul role="list" class="experiences__list container" aria-label="Nos expériences" data-reveal>
      {
        experiences.map((e, i) => (
          <li>
            <a href={url(e.href)} class="exp-card">
              <div class="exp-card__media media media--zoom">
                <Photo src={e.image} alt={e.alt} sizes="(min-width: 64em) 30vw, (min-width: 40em) 45vw, 82vw" />
              </div>
              <span class="exp-card__num">0{i + 1}</span>
              <h3 class="exp-card__title">{e.title}</h3>
              <p class="exp-card__text">{e.text}</p>
              <span class="link-arrow">
                {e.cta} <Icon name="arrow" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ COUCHER DE SOLEIL ============ -->
  <section class="sunset on-dark" aria-labelledby="sunset-titre">
    <div class="sunset__media media">
      <Photo src={sunset} alt="Soleil couchant sur la mer, derrière les herbes des dunes de Penvins" />
    </div>
    <div class="sunset__content container" data-reveal>
      <p class="eyebrow">Le rendez-vous du soir</p>
      <h2 id="sunset-titre">Chaque soir, le soleil se couche <em>face à vous.</em></h2>
      <p class="lead">
        Grande ouverte sur l'océan, la terrasse offre l'un des plus beaux couchers de soleil du Golfe du Morbihan.
        Venez un peu avant l'heure dorée : c'est là que tout commence.
      </p>
    </div>
  </section>

  <!-- ============ GALERIE ============ -->
  <section class="section gallery-preview" aria-labelledby="galerie-titre">
    <div class="container gallery-preview__head">
      <SectionTitle id="galerie-titre" eyebrow="Galerie" title="La Pointe <em>en images</em>" />
      <a class="link-arrow" href={url('galerie-photos/en-photos/')} data-reveal>
        Toute la galerie <Icon name="arrow" />
      </a>
    </div>
    <div class="container">
      <ul role="list" class="mosaic">
        {
          gallery.map((g, i) => (
            <li class:list={['media', 'media--zoom', g.cls]} data-reveal="fade" style={`--reveal-delay:${(i % 4) * 0.08}s`}>
              <Photo src={g.src} alt={g.alt} sizes="(min-width: 64em) 33vw, 50vw" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ AUTOUR DE LA POINTE ============ -->
  <section class="section section--ink around" aria-labelledby="region-titre">
    <div class="container around__head">
      <SectionTitle id="region-titre" eyebrow="La Presqu'île de Rhuys" title="Autour <em>de la pointe</em>">
        <p>
          Penvins se trouve sur la côte sud de la Presqu'île de Rhuys, à quelques minutes du bourg de Sarzeau et
          à environ 35 minutes de Vannes. Une escale idéale entre deux balades.
        </p>
      </SectionTitle>
    </div>
    <ol role="list" class="around__list container">
      {
        around.map((a, i) => (
          <li data-reveal style={`--reveal-delay:${i * 0.1}s`}>
            <div class="around__media media">
              <Photo
                src={a.image}
                alt={a.alt}
                position={a.position}
                sizes="(min-width: 64em) 24vw, (min-width: 40em) 45vw, 82vw"
              />
            </div>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============ INFOS PRATIQUES ============ -->
  <section class="section practical" id="infos" aria-labelledby="infos-titre">
    <div class="container practical__grid">
      <div>
        <SectionTitle id="infos-titre" eyebrow="Infos pratiques" title="Préparer <em>votre venue</em>" />
        <div class="practical__contact" data-reveal>
          <a href={`tel:${business.phoneIntl}`}>
            <Icon name="phone" />
            <span><small>Réservation & renseignements</small>{business.phone}</span>
          </a>
          <a href={`mailto:${business.email}`}>
            <Icon name="mail" />
            <span><small>Groupes & évènements</small>{business.email}</span>
          </a>
          <a href={business.links.maps} target="_blank" rel="noopener">
            <Icon name="pin" />
            <span>
              <small>Adresse</small>
              {business.address.street}, {business.address.postalCode} {business.address.city}
            </span>
          </a>
        </div>
        <div class="practical__routard" data-reveal>
          <div class="practical__routard-img media">
            <Photo src={routard} alt="Plaques « Recommandé par Le Routard » 2019, 2020 et 2022" sizes="7rem" />
          </div>
          <p>
            <strong>Recommandé par Le Routard</strong>
            Distingué en 2019, 2020 et 2022.
          </p>
        </div>
      </div>
      <div class="practical__side">
        <div class="practical__hours" data-reveal>
          <h3>Horaires</h3>
          <Hours />
        </div>
        <div data-reveal>
          <MapEmbed />
        </div>
      </div>
    </div>
  </section>

  <Testimonials />

  <CtaBand
    image={crepuscule}
    alt="Le restaurant La Pointe illuminé à la tombée de la nuit, au-dessus des dunes"
    position="50% 45%"
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    color: var(--foam);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink-2);
  }
  .hero__media :global(img) {
    animation: hero-zoom 14s var(--ease-out) both;
  }
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(8 16 24 / 0.55) 0%, rgb(8 16 24 / 0.1) 32%),
      linear-gradient(0deg, rgb(8 16 24 / 0.9) 0%, rgb(8 16 24 / 0.55) 45%, rgb(8 16 24 / 0.2) 80%);
  }
  .hero__content {
    align-self: end;
    display: grid;
    gap: 1.6rem;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .hero__title {
    font-size: var(--step-5);
    max-width: 12ch;
    line-height: 0.98;
  }
  .hero__title em {
    display: block;
    color: var(--copper-light);
  }
  .hero__lead {
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: rgb(247 243 236 / 0.86);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .hero__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.25rem calc(1.25rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line-light);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: rgb(247 243 236 / 0.8);
  }
  .hero__bar ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.25rem;
  }
  .hero__bar li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__bar :global(svg) {
    color: var(--copper-light);
  }
  .hero__coords {
    letter-spacing: 0.14em;
  }
  .hero__scroll {
    display: none;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.7rem;
    font-weight: 600;
  }
  .hero__scroll :global(svg) {
    animation: nudge 2.4s var(--ease) infinite;
  }
  @media (max-width: 39.99em) {
    .hero__coords,
    .hero__bar li:nth-child(2) {
      display: none !important;
    }
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }
  @media (min-width: 48em) {
    .hero__scroll {
      display: inline-flex;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      animation: rise 1.2s var(--ease-out) both;
      animation-delay: var(--d, 0s);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.12);
    }
  }
  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  /* ---------- Le lieu ---------- */
  .intro__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }
  .intro__text {
    display: grid;
    gap: 2rem;
  }
  .intro__statement {
    font-size: var(--step-3);
    line-height: 1.12;
  }
  .intro__statement em {
    color: var(--copper-text);
  }
  .intro__body {
    display: grid;
    gap: 1.1rem;
    max-width: 34rem;
    color: var(--muted);
    justify-items: start;
  }
  .intro__body .link-arrow {
    margin-top: 0.75rem;
    color: var(--ink);
  }
  .intro__visual {
    position: relative;
    padding-bottom: 12%;
  }
  .intro__main {
    aspect-ratio: 4 / 5;
  }
  .intro__inset {
    position: absolute;
    left: -6%;
    bottom: 0;
    width: 42%;
    aspect-ratio: 4 / 5;
    border: 0.5rem solid var(--foam);
  }
  @media (min-width: 64em) {
    .intro__grid {
      grid-template-columns: 1.05fr 1fr;
    }
    .intro__visual {
      margin-right: calc(-1 * var(--gutter));
    }
    .intro__inset {
      left: -14%;
    }
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
  }
  .figures > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    padding: 2rem 1rem 0 0;
  }
  .figures dd {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--ink);
  }
  .figures dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (min-width: 48em) {
    .figures {
      grid-template-columns: repeat(4, 1fr);
    }
    .figures > div + div {
      padding-left: 2rem;
      border-left: 1px solid var(--line);
    }
  }

  /* ---------- Expériences ---------- */
  .experiences__list {
    display: grid;
    gap: clamp(2rem, 3vw, 3rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .exp-card {
    display: grid;
    gap: 1rem;
    text-decoration: none;
    justify-items: start;
  }
  .exp-card__media {
    width: 100%;
    aspect-ratio: 4 / 5;
    margin-bottom: 0.75rem;
  }
  .exp-card__num {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--copper-text);
  }
  .exp-card__title {
    font-size: var(--step-3);
  }
  .exp-card__text {
    color: var(--muted);
    max-width: 30rem;
  }
  .exp-card .link-arrow {
    margin-top: 0.5rem;
  }
  @media (min-width: 64em) {
    .experiences__list {
      grid-template-columns: repeat(3, 1fr);
    }
    .experiences__list li:nth-child(2) {
      margin-top: 5rem;
    }
    .experiences__list li:nth-child(3) {
      margin-top: 2.5rem;
    }
  }
  /* Mobile : carrousel horizontal natif avec aimantation */
  @media (max-width: 63.99em) {
    .experiences__list {
      grid-auto-flow: column;
      grid-auto-columns: min(82vw, 26rem);
      width: 100%;
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .experiences__list::-webkit-scrollbar {
      display: none;
    }
    .experiences__list li {
      scroll-snap-align: start;
    }
  }

  /* ---------- Coucher de soleil ---------- */
  .sunset {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(36rem, 100svh, 60rem);
    color: var(--foam);
    isolation: isolate;
    overflow: hidden;
  }
  .sunset__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
  }
  .sunset__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(8 16 24 / 0.85), rgb(8 16 24 / 0.1) 60%);
  }
  .sunset__content {
    display: grid;
    gap: 1.5rem;
