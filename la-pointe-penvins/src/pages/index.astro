---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Panorama from '../components/Panorama.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, openingHours, testimonials } from '../data/site';
import { url } from '../data/url';

import hero from '../assets/photos/pointe-penvins-vue-aerienne.jpg';
import ilot from '../assets/photos/ilot-penvins.jpg';
import plage from '../assets/photos/plage-penvins.jpg';
import chapellePlage from '../assets/photos/chapelle-plage.jpg';
import dunes from '../assets/photos/chapelle-dunes.jpg';
import panoramaTerrasse from '../assets/photos/terrasse-panorama.jpg';
import baie from '../assets/photos/baie-voiliers.jpg';
import couchant from '../assets/photos/coucher-soleil-dunes.jpg';
import huitres from '../assets/photos/huitres.jpg';
import guirlandes from '../assets/photos/terrasse-guirlandes.jpg';
import soiree from '../assets/photos/soiree-dj.jpg';
import sunset from '../assets/photos/coucher-soleil.jpg';
import chapelleCiel from '../assets/photos/chapelle-vue-ciel.jpg';
import oyats from '../assets/photos/dunes-oyats.jpg';
import kite from '../assets/photos/kitesurf.jpg';
import presquile from '../assets/photos/presquile-drone.jpg';
import g1 from '../assets/photos/cocktail-passion.jpg';
import g2 from '../assets/photos/salon-terrasse.jpg';
import g3 from '../assets/photos/terrasse-vue-drone.jpg';
import g4 from '../assets/photos/assiette-poisson.jpg';
import g5 from '../assets/photos/terrasse-rose.jpg';
import g6 from '../assets/photos/wing-foil.jpg';
import g7 from '../assets/photos/biere-bar.jpg';
import g8 from '../assets/photos/voie-lactee.jpg';
import g9 from '../assets/photos/enseigne.jpg';
import g10 from '../assets/photos/parasol-dunes.jpg';
import crepuscule from '../assets/photos/restaurant-crepuscule.jpg';

const scenes = [
  { title: 'La pointe', line: "L'îlot, les rochers, l'eau claire.", image: ilot, alt: "Vue aérienne de l'îlot rocheux de la pointe de Penvins et de ses eaux turquoise" },
  { title: 'Le large', line: 'Sable fin et horizon ouvert.', image: plage, alt: 'Plage de sable de Penvins face au large, sous un ciel bleu' },
  { title: 'La chapelle', line: 'Notre-Dame-de-la-Côte, les pieds dans le sable.', image: chapellePlage, alt: 'La chapelle de Penvins au bord de la plage, un catamaran sur le sable' },
  { title: 'Les dunes', line: 'Oyats, sentier côtier et vent du large.', image: dunes, alt: 'Dunes et oyats de Penvins, la chapelle au loin' },
  { title: 'La terrasse', line: 'Notre table, au milieu du paysage.', image: panoramaTerrasse, alt: 'La terrasse de La Pointe et ses parasols au-dessus des dunes, au soleil couchant' },
  { title: 'Le golfe', line: "Voiles blanches et Presqu'île de Rhuys.", image: baie, alt: 'Vue aérienne de la baie et de voiliers au large de la Presqu’île de Rhuys' },
  { title: 'Le couchant', line: 'Le grand final, chaque soir.', image: couchant, alt: 'Soleil rouge se couchant sur la mer derrière les herbes des dunes' },
];

const experiences = [
  { title: 'Le restaurant', line: 'Marée du jour, huîtres du Morbihan, produits bio.', href: 'restaurant-sur-la-plage/', image: huitres, alt: "Plateau d'huîtres du Morbihan au citron, face à la mer" },
  { title: 'Le bar', line: 'Cocktails face au large, dès 11h.', href: 'bar-de-plage/', image: guirlandes, alt: 'Terrasse illuminée de guirlandes au crépuscule, la mer en fond' },
  { title: 'Les soirées', line: 'Concerts, DJ sets et couchers de soleil.', href: 'nos-actualites/', image: soiree, alt: 'Soirée DJ au coucher du soleil devant un van vintage, face à la mer' },
];

const places = [
  { title: 'La chapelle', tag: 'Patrimoine', image: chapelleCiel, alt: 'La chapelle de Penvins vue du ciel, entourée de verdure et de rochers' },
  { title: 'Le sentier côtier', tag: 'Balade · GR34', image: oyats, alt: 'Sentier des dunes bordé d’oyats, la chapelle à l’horizon' },
  { title: 'La glisse', tag: 'Voile · Kite · Wing', image: kite, alt: 'Kitesurfeur en plein saut au large de Penvins' },
  { title: 'Les huîtres', tag: 'Le Tour-du-Parc', image: huitres, alt: 'Huîtres du Morbihan servies au citron' },
  { title: 'La presqu’île', tag: 'Golfe du Morbihan', image: presquile, alt: 'Vue aérienne de la Presqu’île de Rhuys, de ses plages et de la pointe' },
];

const rowA = [g1, g2, g3, g4, g5];
const rowB = [g6, g7, g8, g9, g10];
const quote = testimonials[0];
const h = (t: string) => t.replace(':00', 'h').replace(':', 'h');
---
<BaseLayout
  title="La Pointe — Bar restaurant vue mer à Penvins, Sarzeau · Presqu'île de Rhuys"
  description="La Pointe, bar et restaurant face à l'océan à la Pointe de Penvins (Sarzeau). Vue mer à 270°, produits frais, locaux et bio, cocktails et couchers de soleil sur la Presqu'île de Rhuys. Réservez votre table."
>
  <!-- ============ HERO ============ -->
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="hero__media media">
      <Photo
        src={hero}
        alt="Vue aérienne de la Pointe de Penvins, entre plage, rochers et eaux turquoise"
        priority
        position="50% 60%"
      />
    </div>
    <div class="hero__content container">
      <p class="eyebrow">Penvins · Sarzeau · Presqu'île de Rhuys</p>
      <h1 id="hero-title" class="hero__title">
        La Pointe<span class="visually-hidden"> — bar, restaurant et terrasse vue mer à Penvins</span>
      </h1>
      <p class="hero__tagline">Bar · Restaurant · Terrasse <em>face à l'océan</em></p>
      <div class="hero__actions">
        <a class="btn btn--light" href={business.links.booking} target="_blank" rel="noopener">
          Réserver <Icon name="arrow" />
        </a>
        <a class="btn btn--ghost-light" href="#panorama">Explorer</a>
      </div>
    </div>
    <a class="hero__scroll" href="#panorama" aria-label="Commencer le panorama">
      <span class="hero__scroll-line"></span>
    </a>
  </section>

  <!-- ============ PANORAMA 270° ============ -->
  <div id="panorama">
    <Panorama scenes={scenes} />
  </div>

  <!-- ============ EXPÉRIENCES ============ -->
  <section class="section exp" aria-labelledby="exp-title">
    <div class="container exp__head" data-reveal>
      <p class="eyebrow">Vivre la Pointe</p>
      <h2 id="exp-title">Trois <em>envies</em></h2>
    </div>
    <ul role="list" class="exp__list container">
      {
        experiences.map((e, i) => (
          <li data-reveal style={`--reveal-delay:${i * 0.1}s`}>
            <a class="exp-card" href={url(e.href)}>
              <div class="exp-card__media media media--parallax">
                <div data-parallax="0.12">
                  <Photo src={e.image} alt={e.alt} sizes="(min-width: 64em) 32vw, 88vw" />
                </div>
              </div>
              <div class="exp-card__body">
                <h3>{e.title}</h3>
                <p>{e.line}</p>
                <Icon name="arrow" class="exp-card__arrow" />
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ LE COUCHANT ============ -->
  <section class="sunset on-dark" aria-labelledby="sunset-title">
    <div class="sunset__media media media--parallax">
      <div data-parallax="0.2">
        <Photo src={sunset} alt="Soleil rouge se couchant sur la mer derrière les dunes de Penvins" />
      </div>
    </div>
    <div class="container sunset__content" data-reveal>
      <h2 id="sunset-title">Chaque soir,<br /><em>le grand spectacle.</em></h2>
    </div>
  </section>

  <!-- ============ À DÉCOUVRIR ============ -->
  <section class="section around" aria-labelledby="around-title">
    <div class="container around__head" data-reveal>
      <div>
        <p class="eyebrow">Autour de la pointe</p>
        <h2 id="around-title">À <em>découvrir</em></h2>
      </div>
      <p class="around__aside">
        Château de Suscinio · Golfe du Morbihan · Vannes à 35 min
      </p>
    </div>
    <ul role="list" class="around__strip" aria-label="Lieux et activités autour de Penvins" data-reveal>
      {
        places.map((p, i) => (
          <li class="place">
            <div class="place__media media media--zoom">
              <Photo src={p.image} alt={p.alt} sizes="(min-width: 64em) 26vw, 72vw" />
            </div>
            <span class="place__num">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.tag}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ GALERIE EN MOUVEMENT ============ -->
  <section class="reel" aria-labelledby="reel-title">
    <h2 id="reel-title" class="visually-hidden">La Pointe en images</h2>
    <div class="reel__row" data-drift="-0.18">
      {rowA.map((src) => (
        <div class="reel__item media"><Photo src={src} alt="" sizes="(min-width: 48em) 28vw, 60vw" /></div>
      ))}
    </div>
    <div class="reel__row reel__row--b" data-drift="0.18">
      {rowB.map((src) => (
        <div class="reel__item media"><Photo src={src} alt="" sizes="(min-width: 48em) 28vw, 60vw" /></div>
      ))}
    </div>
    <div class="container reel__cta">
      <a class="link-arrow" href={url('galerie-photos/en-photos/')}>Toute la galerie <Icon name="arrow" /></a>
    </div>
  </section>

  <!-- ============ AVIS ============ -->
  <section class="section quote" aria-label="Avis client">
    <figure class="container--narrow" data-reveal>
      <blockquote>
        <p>« {quote.quote} »</p>
      </blockquote>
      <figcaption>{quote.author} · Avis Google</figcaption>
    </figure>
  </section>

  <!-- ============ INFOS ============ -->
  <section class="section section--sand info" id="infos" aria-labelledby="info-title">
    <div class="container">
      <h2 id="info-title" class="info__title" data-reveal>Infos <em>pratiques</em></h2>
      <div class="info__grid">
        <div class="info__col" data-reveal>
          <Icon name="clock" />
          <h3>Horaires</h3>
          <p>
            7j/7 en saison<br />
            {h(openingHours[0].open)} – {h(openingHours[0].close)} · dimanche → {h(openingHours[6].close)}
          </p>
          <a class="link-arrow" href={business.links.google} target="_blank" rel="noopener">
            Horaires du jour <Icon name="external" />
          </a>
        </div>
        <div class="info__col" data-reveal style="--reveal-delay:0.1s">
          <Icon name="pin" />
          <h3>Venir</h3>
          <p>
            {business.address.street}<br />
            {business.address.postalCode} {business.address.city}
          </p>
          <a class="link-arrow" href={business.links.maps} target="_blank" rel="noopener">
            Itinéraire <Icon name="external" />
          </a>
        </div>
        <div class="info__col" data-reveal style="--reveal-delay:0.2s">
          <Icon name="calendar" />
          <h3>Réserver</h3>
          <p>
            En ligne ou par téléphone<br />
            <a href={`tel:${business.phoneIntl}`}>{business.phone}</a>
          </p>
          <a class="link-arrow" href={business.links.booking} target="_blank" rel="noopener">
            Réserver une table <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    image={crepuscule}
    alt="Le restaurant La Pointe illuminé à la tombée de la nuit, au-dessus des dunes"
    position="50% 45%"
  />
</BaseLayout>

<style>
  h2 {
    font-size: var(--step-4);
  }
  h2 em {
    color: var(--copper-text);
  }
  .on-dark h2 em {
    color: var(--copper-light);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    color: var(--foam);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink-2);
  }
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(8 16 24 / 0.5) 0%, rgb(8 16 24 / 0) 30%),
      linear-gradient(0deg, rgb(8 16 24 / 0.85) 0%, rgb(8 16 24 / 0.3) 50%, rgb(8 16 24 / 0.1) 80%);
  }
  .hero__content {
    display: grid;
    gap: 1.25rem;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(5rem, 12vh, 8rem);
  }
  .hero__title {
    font-size: clamp(4.5rem, 2rem + 13vw, 15rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
  }
  .hero__tagline {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: rgb(247 243 236 / 0.9);
  }
  .hero__tagline em {
    color: var(--copper-light);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: 2.75rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    transform: translateX(-50%);
  }
  .hero__scroll-line {
    width: 1px;
    height: 100%;
    background: linear-gradient(rgb(247 243 236 / 0), var(--foam));
    transform-origin: top;
    animation: scroll-cue 2.4s var(--ease) infinite;
  }
  @media (max-width: 47.99em) {
    .hero__scroll {
      display: none;
    }
  }
  @keyframes scroll-cue {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__content > * {
      animation: rise 1.3s var(--ease-out) both;
    }
    .hero__content > :nth-child(3) {
      animation-delay: 0.15s;
    }
    .hero__content > :nth-child(4) {
      animation-delay: 0.3s;
    }
    .hero__media :global(img) {
      animation: settle 2.6s var(--ease-out) both;
    }
    /* Caméra qui avance : zoom et fondu pilotés par le défilement (navigateurs compatibles) */
    @supports (animation-timeline: scroll()) {
      .hero__media {
        animation: push-in linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .hero__content {
        animation: lift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 70vh;
      }
    }
  }
  @keyframes rise {
    from {
      transform: translateY(30px);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.1);
    }
  }
  @keyframes push-in {
    to {
      transform: scale(1.18);
    }
  }
  @keyframes lift {
    to {
      transform: translateY(-12vh);
      opacity: 0;
    }
  }

  /* ---------- Expériences ---------- */
  .exp__head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .exp__list {
    display: grid;
    gap: 1.25rem;
  }
  .exp-card {
    position: relative;
    display: block;
    color: var(--foam);
    text-decoration: none;
    overflow: hidden;
  }
  .exp-card__media {
    aspect-ratio: 3 / 4;
    max-height: 80svh;
    width: 100%;
  }
  .exp-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(8 16 24 / 0.75), rgb(8 16 24 / 0) 55%);
    transition: background-color 0.6s var(--ease);
  }
  .exp-card:hover .exp-card__media::after {
    background-color: rgb(8 16 24 / 0.15);
  }
  .exp-card__media :global(img) {
    transition: transform 1.4s var(--ease-out);
  }
  .exp-card:hover .exp-card__media :global(img) {
    transform: scale(1.05);
  }
  .exp-card__body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 0.4rem 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .exp-card h3 {
    font-size: var(--step-3);
    grid-column: 1;
  }
  .exp-card p {
    grid-column: 1;
    font-size: 0.95rem;
    color: rgb(247 243 236 / 0.82);
  }
  .exp-card :global(.exp-card__arrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.7rem;
    border: 1px solid rgb(247 243 236 / 0.5);
    border-radius: 50%;
    transition:
      background-color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .exp-card:hover :global(.exp-card__arrow) {
    background: var(--copper);
    border-color: var(--copper);
  }
  @media (min-width: 64em) {
    .exp__list {
      grid-template-columns: repeat(3, 1fr);
    }
    .exp__list li:nth-child(2) {
      margin-top: 6rem;
    }
  }

  /* ---------- Couchant ---------- */
  .sunset {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 110svh;
    color: var(--foam);
    isolation: isolate;
    overflow: hidden;
  }
  .sunset__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
  }
  .sunset__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(8 16 24 / 0.35);
  }
  .sunset h2 {
    font-size: var(--step-5);
  }

  /* ---------- À découvrir ---------- */
  .around__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .around__head > div {
    display: grid;
    gap: 1rem;
  }
  .around__aside {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .around__strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 24rem);
    gap: 1.25rem;
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2));
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }
  .around__strip::-webkit-scrollbar {
    display: none;
  }
  .place {
    display: grid;
    gap: 0.4rem;
    scroll-snap-align: start;
  }
  .place__media {
    aspect-ratio: 4 / 5;
    margin-bottom: 0.9rem;
  }
  .place__num {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--copper-text);
  }
  .place h3 {
    font-size: var(--step-2);
  }
  .place p {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------- Bandeaux d'images en mouvement ---------- */
  .reel {
    padding-block: calc(var(--section) * 0.5) var(--section);
    overflow: hidden;
  }
  .reel__row {
    display: flex;
    gap: clamp(0.5rem, 1vw, 1rem);
    width: max-content;
    margin-left: -10vw;
  }
  .reel__row--b {
    margin-top: clamp(0.5rem, 1vw, 1rem);
    margin-left: -30vw;
  }
  .reel__item {
    width: clamp(15rem, 28vw, 30rem);
    aspect-ratio: 4 / 3;
  }
  .reel__cta {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
  }

  /* ---------- Avis ---------- */
  .quote {
    text-align: center;
    padding-top: 0;
  }
  .quote figure {
    display: grid;
    gap: 1.75rem;
  }
  .quote blockquote {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.15;
  }
  .quote figcaption {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------- Infos ---------- */
  .info__title {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .info__grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
  }
  .info__col {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    justify-items: start;
    padding: 2.25rem 0;
    background: var(--sand);
  }
  .info__col > :global(svg) {
    color: var(--copper);
  }
  .info__col h3 {
    font-size: var(--step-2);
  }
  .info__col p {
    color: var(--muted);
  }
  .info__col p a {
    color: var(--ink);
    font-size: var(--step-1);
    text-decoration: none;
  }
  @media (min-width: 48em) {
    .info__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .info__col {
      padding: 2.5rem 2rem;
    }
    .info__col:first-child {
      padding-left: 0;
    }
  }
</style>
