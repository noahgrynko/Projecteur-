---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Photo from '../../../components/Photo.astro';
import Icon from '../../../components/Icon.astro';
import CtaBand from '../../../components/CtaBand.astro';

import hero from '../../../assets/photos/terrasse-vue-drone.jpg';
import cta from '../../../assets/photos/plage-crepuscule.jpg';

type Category = 'lieu' | 'table' | 'ambiance' | 'nature';
const categories: { id: Category | 'all'; label: string }[] = [
  { id: 'all', label: 'Tout' },
  { id: 'lieu', label: 'Le lieu' },
  { id: 'table', label: 'À table' },
  { id: 'ambiance', label: 'Ambiance' },
  { id: 'nature', label: 'Nature & glisse' },
];

const photos = import.meta.glob<{ default: ImageMetadata }>('../../../assets/photos/*.jpg', { eager: true });
const p = (name: string) => photos[`../../../assets/photos/${name}.jpg`].default;

const items: { name: string; alt: string; cat: Category }[] = [
  { name: 'terrasse-panorama', alt: 'La terrasse et ses parasols face à la mer au soleil couchant', cat: 'lieu' },
  { name: 'cocktail-passion', alt: 'Cocktail crémeux à la passion décoré d’un physalis', cat: 'table' },
  { name: 'pointe-penvins-vue-aerienne', alt: 'Vue aérienne de la Pointe de Penvins et de ses eaux turquoise', cat: 'nature' },
  { name: 'terrasse-guirlandes', alt: 'Terrasse illuminée de guirlandes au crépuscule', cat: 'ambiance' },
  { name: 'huitres', alt: 'Huîtres du Morbihan au citron', cat: 'table' },
  { name: 'enseigne', alt: 'Enseigne ronde La Pointe sur la façade en bois', cat: 'lieu' },
  { name: 'coucher-soleil', alt: 'Soleil rouge se couchant sur la mer derrière les dunes', cat: 'nature' },
  { name: 'salon-terrasse', alt: 'Salon extérieur aux coussins bleus sur la terrasse', cat: 'lieu' },
  { name: 'soiree-dj', alt: 'Soirée DJ au coucher du soleil devant un van vintage', cat: 'ambiance' },
  { name: 'assiette-poisson', alt: 'Poisson sur crème de betterave et jeunes pousses', cat: 'table' },
  { name: 'kitesurf', alt: 'Kitesurfeur en plein saut au large de la pointe', cat: 'nature' },
  { name: 'terrasse-rose', alt: 'Terrasse en bois sous un ciel rose', cat: 'ambiance' },
  { name: 'chapelle-plage', alt: 'La chapelle de Penvins au bord de la plage animée', cat: 'nature' },
  { name: 'biere-bar', alt: 'Bière servie au comptoir du bar', cat: 'table' },
  { name: 'parasol-dunes', alt: 'Clients sous un parasol parmi les fleurs des dunes', cat: 'ambiance' },
  { name: 'ilot-penvins', alt: 'Îlot rocheux de Penvins vu du ciel', cat: 'nature' },
  { name: 'salle-veranda', alt: 'Salle couverte du restaurant ouverte sur la mer', cat: 'lieu' },
  { name: 'terrasse-convives', alt: 'Tablée d’amis servie en terrasse', cat: 'ambiance' },
  { name: 'voie-lactee', alt: 'Voie lactée au-dessus de la mer et plancton bioluminescent', cat: 'nature' },
  { name: 'passe-cuisine', alt: 'La passe de la cuisine pendant le service', cat: 'table' },
  { name: 'terrasse-ciel-bleu', alt: 'Parasols et banquettes de la terrasse sous un ciel bleu', cat: 'lieu' },
  { name: 'wing-foil', alt: 'Wing foil dans les vagues de Penvins', cat: 'nature' },
  { name: 'restaurant-crepuscule', alt: 'Le restaurant illuminé à la tombée de la nuit', cat: 'lieu' },
  { name: 'terrasse-soir', alt: 'La terrasse à l’heure bleue', cat: 'ambiance' },
  { name: 'dessert', alt: 'Dessert gourmand du restaurant', cat: 'table' },
  { name: 'chapelle-vue-ciel', alt: 'La chapelle de Penvins vue du ciel', cat: 'nature' },
  { name: 'service-terrasse', alt: 'Service des boissons en terrasse en plein soleil', cat: 'ambiance' },
  { name: 'chapelle-tempete', alt: 'La chapelle dans les embruns d’un jour de tempête', cat: 'nature' },
  { name: 'dunes-oyats', alt: 'Oyats des dunes et chapelle au loin', cat: 'nature' },
  { name: 'baie-voiliers', alt: 'La baie et ses voiliers vue du ciel', cat: 'nature' },
];

const gallery = await Promise.all(
  items.map(async (item) => {
    const src = p(item.name);
    const full = await getImage({ src, width: Math.min(src.width, 1920), format: 'webp', quality: 78 });
    return { ...item, src, full: full.src, portrait: src.height > src.width };
  }),
);
---
<BaseLayout
  title="Galerie photos — La Pointe, bar restaurant à Penvins, Sarzeau"
  description="La Pointe en images : terrasse vue mer, cuisine, cocktails, couchers de soleil et paysages de la Pointe de Penvins, sur la Presqu'île de Rhuys."
  image={hero}
  imageAlt="Vue aérienne de la terrasse de La Pointe et de ses parasols"
  breadcrumb={[{ name: 'Galerie', path: 'galerie-photos/en-photos/' }]}
>
  <PageHero
    eyebrow="Galerie"
    title="La Pointe <em>en images</em>"
    image={hero}
    alt="Vue aérienne de la terrasse de La Pointe, ses parasols blancs et la végétation des dunes"
  />

  <section class="section gallery" aria-label="Photos de La Pointe">
    <div class="container">
      <div class="filters" role="group" aria-label="Filtrer les photos" data-filters>
        {
          categories.map((c, i) => (
            <button type="button" class="filter" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {c.label}
            </button>
          ))
        }
      </div>
      <p class="visually-hidden" aria-live="polite" data-filter-status></p>

      <ul role="list" class="grid" data-gallery>
        {
          gallery.map((g, i) => (
            <li class:list={['grid__item', { 'grid__item--tall': g.portrait }]} data-cat={g.cat}>
              <a
                href={g.full}
                class="grid__link media media--zoom"
                data-lightbox
                data-index={i}
                aria-label={`${g.alt} (agrandir)`}
              >
                <Photo src={g.src} alt={g.alt} sizes="(min-width: 64em) 25vw, (min-width: 40em) 33vw, 50vw" />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="credit">Photos © La Pointe et leurs auteurs — reproduction interdite.</p>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Visionneuse de photos" data-lightbox-dialog>
    <figure class="lightbox__figure">
      <img alt="" data-lightbox-img />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__close" data-lightbox-close aria-label="Fermer">
      <Icon name="close" />
    </button>
    <button type="button" class="lightbox__btn lightbox__prev" data-lightbox-prev aria-label="Photo précédente">
      <Icon name="arrow" />
    </button>
    <button type="button" class="lightbox__btn lightbox__next" data-lightbox-next aria-label="Photo suivante">
      <Icon name="arrow" />
    </button>
    <p class="lightbox__count" data-lightbox-count></p>
  </dialog>

  <CtaBand image={cta} alt="Plage de Penvins au crépuscule, mer calme et ciel orangé" eyebrow="En vrai, c'est encore mieux" />
</BaseLayout>

<style>
  .filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }
  .filter {
    flex: none;
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: transparent;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .filter:hover {
    border-color: var(--ink);
  }
  .filter[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--foam);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(8rem, 20vw, 15rem);
    grid-auto-flow: dense;
    gap: clamp(0.4rem, 0.8vw, 0.9rem);
  }
  .grid__item--tall {
    grid-row: span 2;
  }
  .grid__item[hidden] {
    display: none;
  }
  .grid__link {
    display: block;
    height: 100%;
  }
  @media (min-width: 40em) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 64em) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .credit {
    margin-top: 2rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(8 14 20 / 0.96);
    color: var(--foam);
  }
  .lightbox::backdrop {
    background: rgb(8 14 20 / 0.9);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: fade 0.35s var(--ease);
  }
  .lightbox__figure {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: 4.5rem 1rem 5rem;
    max-width: 100%;
    max-height: 100%;
  }
  .lightbox__figure img {
    max-width: min(92vw, 1600px);
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lightbox__figure figcaption {
    font-size: 0.9rem;
    color: rgb(247 243 236 / 0.75);
    text-align: center;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--line-light);
    border-radius: 50%;
    background: rgb(8 14 20 / 0.5);
    color: var(--foam);
    transition: background-color 0.3s var(--ease);
  }
  .lightbox__btn:hover {
    background: var(--copper);
  }
  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox__prev,
  .lightbox__next {
    bottom: 1rem;
  }
  .lightbox__prev {
    left: 1rem;
  }
  .lightbox__prev :global(svg) {
    transform: rotate(180deg);
  }
  .lightbox__next {
    right: 1rem;
  }
  .lightbox__count {
    position: absolute;
    bottom: 1.9rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
  }
  @media (min-width: 48em) {
    .lightbox__prev,
    .lightbox__next {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }
    .lightbox__prev {
      left: 1.5rem;
    }
    .lightbox__next {
      right: 1.5rem;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const items = [...document.querySelectorAll<HTMLLIElement>('[data-gallery] > li')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  // ---- Filtres ----
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button, _, all) => {
    button.addEventListener('click', () => {
      const cat = button.dataset.filter;
      all.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      let count = 0;
      items.forEach((li) => {
        const show = cat === 'all' || li.dataset.cat === cat;
        li.hidden = !show;
        if (show) count++;
      });
      if (status) status.textContent = `${count} photos affichées`;
    });
  });

  // ---- Visionneuse (dialog natif : focus et Échap gérés par le navigateur) ----
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const img = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const caption = document.querySelector<HTMLElement>('[data-lightbox-caption]');
  const counter = document.querySelector<HTMLElement>('[data-lightbox-count]');
  let current = 0;
  let opener: HTMLElement | null = null;

  const visibleLinks = () =>
    items.filter((li) => !li.hidden).map((li) => li.querySelector<HTMLAnchorElement>('[data-lightbox]')!);

  const show = (index: number) => {
    const links = visibleLinks();
    current = (index + links.length) % links.length;
    const link = links[current];
    const alt = link.querySelector('img')?.alt ?? '';
    if (img) {
      img.src = link.href;
      img.alt = alt;
    }
    if (caption) caption.textContent = alt;
    if (counter) counter.textContent = `${current + 1} / ${links.length}`;
  };

  if (grid && dialog && 'showModal' in dialog) {
    grid.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-lightbox]');
      if (!link) return;
      e.preventDefault();
      opener = link;
      show(visibleLinks().indexOf(link));
      dialog.showModal();
    });
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
    dialog.addEventListener('close', () => opener?.focus());

    // Balayage tactile
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>
