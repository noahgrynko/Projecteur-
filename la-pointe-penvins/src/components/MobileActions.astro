---
import Icon from './Icon.astro';
import { business } from '../data/site';
---
<div class="mobile-actions" data-mobile-actions>
  <a href={`tel:${business.phoneIntl}`} class="mobile-actions__call">
    <Icon name="phone" size={18} /> Appeler
  </a>
  <a href={business.links.booking} target="_blank" rel="noopener" class="mobile-actions__book">
    Réserver une table
  </a>
</div>

<style>
  .mobile-actions {
    position: fixed;
    inset: auto 0.75rem calc(0.75rem + env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    grid-template-columns: auto 1fr;
    border-radius: 3px;
    overflow: hidden;
    box-shadow: 0 18px 40px -12px rgb(8 16 24 / 0.55);
    transform: translateY(calc(100% + 2rem));
    transition: transform 0.6s var(--ease-out);
  }
  .mobile-actions.is-visible {
    transform: none;
  }
  .mobile-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.4rem;
    padding-inline: 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .mobile-actions__call {
    background: var(--foam);
    color: var(--ink);
  }
  .mobile-actions__book {
    background: var(--ink);
    color: var(--foam);
  }
  @media (min-width: 48em) {
    .mobile-actions {
      display: none;
    }
  }
  :global(html.menu-open) .mobile-actions {
    transform: translateY(calc(100% + 2rem));
  }
</style>

<script>
  // Affiche la barre d'actions mobile une fois le premier écran dépassé.
  const bar = document.querySelector<HTMLElement>('[data-mobile-actions]');
  if (bar) {
    const onScroll = () => bar.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.7);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
