---
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import { testimonials, business } from '../data/site';
---
<section class="section testimonials" aria-labelledby="avis-titre">
  <div class="container">
    <div class="testimonials__head">
      <SectionTitle id="avis-titre" eyebrow="Ils en parlent" title="Le plus beau spot <em>de la presqu'île</em>" />
      <a class="link-arrow" href={business.links.google} target="_blank" rel="noopener" data-reveal>
        Tous les avis Google <Icon name="arrow" />
      </a>
    </div>
    <ul role="list" class="testimonials__list">
      {
        testimonials.map((t, i) => (
          <li data-reveal style={`--reveal-delay:${i * 0.12}s`}>
            <figure>
              <Icon name="quote" class="testimonials__mark" size={28} />
              <blockquote>
                <p>« {t.quote} »</p>
              </blockquote>
              <figcaption>{t.author}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .testimonials__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .testimonials__list {
    display: grid;
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .testimonials__list li {
    background: var(--foam);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.5rem);
  }
  .testimonials__list li:first-child {
    padding-left: 0;
  }
  figure {
    display: grid;
    gap: 1.5rem;
    height: 100%;
    grid-template-rows: auto 1fr auto;
  }
  figure :global(.testimonials__mark) {
    color: var(--copper);
  }
  blockquote {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
  }
  figcaption {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 47.99em) {
    .testimonials__list li {
      padding-inline: 0;
    }
  }
</style>
