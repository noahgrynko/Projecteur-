---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

/** En-tête immersif des pages intérieures. */
interface Props {
  eyebrow: string;
  title: string;
  image: ImageMetadata;
  alt: string;
  position?: string;
}
const { eyebrow, title, image, alt, position } = Astro.props;
---
<section class="page-hero on-dark">
  <div class="page-hero__media media media--parallax">
    <div data-parallax="0.18">
      <Photo src={image} alt={alt} priority position={position} />
    </div>
  </div>
  <div class="page-hero__content container">
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={title} />
    {
      Astro.slots.has('default') && (
        <div class="page-hero__text">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(30rem, 78svh, 52rem);
    color: var(--foam);
    isolation: isolate;
    overflow: hidden;
  }
  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink-2);
  }
  .page-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(8 16 24 / 0.5) 0%, rgb(8 16 24 / 0) 30%),
      linear-gradient(90deg, rgb(8 16 24 / 0.55) 0%, rgb(8 16 24 / 0) 70%),
      linear-gradient(0deg, rgb(8 16 24 / 0.85) 0%, rgb(8 16 24 / 0.35) 55%, rgb(8 16 24 / 0.1) 80%);
  }
  .page-hero__media :global(img) {
    animation: hero-settle 2.4s var(--ease-out) both;
  }
  .page-hero__content {
    padding-block: calc(var(--header-h) + 3rem) clamp(3rem, 7vw, 6rem);
  }
  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.6rem, 1.8rem + 4.2vw, 6rem);
    max-width: 16ch;
  }
  h1 :global(em) {
    color: var(--copper-light);
  }
  .page-hero__text {
    margin-top: 1.75rem;
    max-width: 38rem;
    font-size: var(--step-1);
    color: rgb(247 243 236 / 0.85);
  }
  @keyframes hero-settle {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }
</style>
