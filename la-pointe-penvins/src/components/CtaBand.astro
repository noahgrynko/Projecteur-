---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { business } from '../data/site';

/** Bandeau final d'appel à l'action, plein cadre. */
interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title?: string;
  position?: string;
}
const {
  image,
  alt,
  eyebrow = 'Réservation',
  title = 'Votre table <em>face au large</em> vous attend.',
  position,
} = Astro.props;
---
<section class="cta on-dark" aria-labelledby="cta-titre">
  <div class="cta__media media">
    <Photo src={image} alt={alt} position={position} />
  </div>
  <div class="cta__content container" data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="cta-titre" set:html={title} />
    <p class="lead">
      Réservez en ligne en quelques secondes, ou appelez-nous — idéalement en dehors des heures de service.
    </p>
    <div class="cta__actions">
      <a class="btn btn--light" href={business.links.booking} target="_blank" rel="noopener">
        Réserver en ligne <Icon name="arrow" />
      </a>
      <a class="btn btn--ghost-light" href={`tel:${business.phoneIntl}`}>
        <Icon name="phone" /> {business.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(34rem, 90svh, 50rem);
    color: var(--foam);
    isolation: isolate;
    overflow: hidden;
    text-align: center;
  }
  .cta__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
  }
  .cta__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgb(8 16 24 / 0.45), rgb(8 16 24 / 0.78));
  }
  .cta__content {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    padding-block: var(--section);
    max-width: 52rem;
  }
  h2 {
    font-size: var(--step-5);
  }
  h2 :global(em) {
    color: var(--copper-light);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
