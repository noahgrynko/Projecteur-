---
/** Monogramme + logotype typographique de La Pointe. */
interface Props {
  class?: string;
  compact?: boolean;
}
const { class: className, compact = false } = Astro.props;
---
<span class:list={['logo', className, { 'logo--compact': compact }]}>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
    <path d="M24 9 31 27H17z" fill="currentColor"></path>
    <path
      d="M10 31.5c2.3 0 2.3-1.6 4.7-1.6s2.3 1.6 4.6 1.6 2.4-1.6 4.7-1.6 2.3 1.6 4.7 1.6 2.3-1.6 4.6-1.6 2.4 1.6 4.7 1.6M12.5 36.5c1.9 0 1.9-1.3 3.8-1.3s1.9 1.3 3.9 1.3 1.9-1.3 3.8-1.3 1.9 1.3 3.9 1.3 1.9-1.3 3.8-1.3 1.9 1.3 3.8 1.3"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">La Pointe</span>
    {!compact && <span class="logo__sub">Penvins · Sarzeau</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    line-height: 1;
  }
  .logo__mark {
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
  }
  .logo__text {
    display: grid;
    gap: 0.3rem;
  }
  .logo__name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    letter-spacing: 0.01em;
  }
  .logo__sub {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.8;
  }
</style>
